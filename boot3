esphome:
  name: esp-boot
  friendly_name: ESP-Boot
  on_boot:
    priority: -100
    then:
      - light.turn_on: display_backlight

esp32:
  board: esp32-s3-devkitc-1
  framework:
    type: arduino

logger:
  level: DEBUG

external_components:
  - source:
      type: local
      path: my_components
    components: [ custom_backlight, ft6236 ]

wifi:
  ssid: "FRITZ!Box 7590 JL"
  password: "28182272528993262336"

api:
ota:
  - platform: esphome

i2c:
  - id: bus_a
    sda: GPIO4
    scl: GPIO5
    frequency: 400khz
    scan: true

spi:
  - id: spi_bus
    clk_pin: GPIO10
    mosi_pin: GPIO11

pca9554:
  - id: tca9554_hub
    address: 0x20

output:
  - platform: custom_backlight
    id: backlight_output

light:
  - platform: binary
    name: "Display Backlight"
    output: backlight_output
    id: display_backlight

display:
  platform: ili9xxx
  id: display_lcd
  spi_id: spi_bus
  model: ST7789V
  invert_colors: true
  cs_pin: GPIO9
  dc_pin: GPIO13
  reset_pin: GPIO14
  rotation: 0°
  lambda: |-
    it.fill(Color(255, 0, 0));
